+    def _lora_depth_ok(self, req: Req, running_loras: set[Optional[str]]) -> bool:
+        """Give a free adapter slot only to the adapters with the most waiting requests.
+
+        A request that has waited longer than SGLANG_LORA_DEPTH_MAX_AGE_S (default 10) is
+        always allowed, so adapters with few waiting requests are delayed, not starved.
+        """
+        free = (
+            self.tp_worker.model_runner.lora_manager.max_loras_per_batch
+            - len(running_loras)
+        )
+        c = self.__dict__.setdefault("_depth_stats", [0, 0, 0, 0])  # calls, free==0, aged, rejected
+        c[0] += 1
+        if c[0] % 2000 == 0:
+            logger.warning("lora_depth calls=%d no_free=%d aged_allow=%d rejected=%d", *c)
+        if free <= 0:
+            c[1] += 1
+            return True
+        max_age = float(os.environ.get("SGLANG_LORA_DEPTH_MAX_AGE_S", "10"))
+        if time.perf_counter() - req.time_stats.wait_queue_entry_time > max_age:
+            c[2] += 1
+            return True
+        depth = self._lora_depth
+        counts = sorted((n for k, n in depth.items() if k not in running_loras), reverse=True)
+        if len(counts) <= free:
+            return True
+        ok = depth[req.lora_id] >= counts[free - 1]
+        if not ok:
+            c[3] += 1
+        return ok
+
